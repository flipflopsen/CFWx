{
  "cmake.useCMakePresets": "always",
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.configureOnOpen": false,
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp_Runner.cCompilerPath": "gcc",
  "C_Cpp_Runner.cppCompilerPath": "g++",
  "C_Cpp_Runner.debuggerPath": "gdb",
  "C_Cpp_Runner.cStandard": "c17",
  "C_Cpp_Runner.cppStandard": "c++17",
  "C_Cpp_Runner.useMsvc": false,
  "C_Cpp_Runner.enableWarnings": true,
  "C_Cpp_Runner.warningsAsError": false,
  "C_Cpp_Runner.warnings": ["-Wall", "-Wextra", "-Wpedantic"],
  "C_Cpp_Runner.includePaths": ["${workspaceFolder}/include"],
  "C_Cpp_Runner.excludeSearch": ["**/build/**", "**/bin/**", "**/doxygen_docs/generated/**", "**/.git/**"],
  "files.exclude": {"**/doxygen_docs/generated": true},
  "search.exclude": {"**/build/**": true, "**/doxygen_docs/generated/**": true}
}
