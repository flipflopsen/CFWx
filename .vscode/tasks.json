{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CFWx-Task: Build",
            "type": "shell",
            "command": "cd build && cmake .. && cmake --build .",
            "options": {
                "cwd": "/full/path/to/CFWx"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
