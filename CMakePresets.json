{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "cpu-base", "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CFWX_USE_VCPKG": "OFF", "CFWX_CUDA": "OFF",
        "CFWX_REGISTER_GPU_TESTS": "OFF", "CFWX_SANITIZERS": "OFF",
        "BUILD_TESTING": "ON", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {"name": "cpu-debug", "displayName": "CPU Debug (Linux/WSL)", "inherits": "cpu-base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "cpu-release", "displayName": "CPU Release (Linux/WSL)", "inherits": "cpu-base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "cpu-asan", "displayName": "CPU Debug + ASan/UBSan", "inherits": "cpu-debug", "cacheVariables": {"CFWX_SANITIZERS": "ON"}},
    {"name": "cuda-release", "displayName": "CUDA SM89 (manual opt-in)", "inherits": "cpu-release", "cacheVariables": {"CFWX_CUDA": "ON", "CFWX_CUDA_ARCHITECTURES": "89"}}
  ],
  "buildPresets": [
    {"name": "cpu-debug", "configurePreset": "cpu-debug"},
    {"name": "cpu-release", "configurePreset": "cpu-release"},
    {"name": "cpu-asan", "configurePreset": "cpu-asan"},
    {"name": "cuda-release", "configurePreset": "cuda-release"}
  ],
  "testPresets": [
    {"name": "cpu-debug", "configurePreset": "cpu-debug", "output": {"outputOnFailure": true}},
    {"name": "cpu-release", "configurePreset": "cpu-release", "output": {"outputOnFailure": true}},
    {"name": "cpu-asan", "configurePreset": "cpu-asan", "output": {"outputOnFailure": true}, "environment": {"ASAN_OPTIONS": "detect_leaks=1"}}
  ]
}
