# No CUDA discovery occurs unless the user opts in on their own machine.
option(CFWX_CUDA "Build CUDA analytic Transformer backend" OFF)
option(CFWX_REGISTER_GPU_TESTS "Register manual GPU tests with CTest" OFF)
if(CFWX_CUDA)
    if(CMAKE_VERSION VERSION_LESS 3.24)
        message(FATAL_ERROR "CUDA backend requires CMake >= 3.24; CPU build keeps original minimum")
    endif()
    if(CFWX_SANITIZERS)
        message(FATAL_ERROR "Use a separate build tree: CPU ASan flags and CUDA are not combined")
    endif()
    enable_language(CUDA)
    set(CFWX_CUDA_ARCHITECTURES "89" CACHE STRING "RTX 4090 SM architecture")
    add_library(cfwx_cuda STATIC src/gpu/cuda_training.cu)
    target_include_directories(cfwx_cuda PUBLIC ${CMAKE_SOURCE_DIR}/include)
    set_target_properties(cfwx_cuda PROPERTIES CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON
        CUDA_ARCHITECTURES "${CFWX_CUDA_ARCHITECTURES}")
    # No --use_fast_math: gradient/parity validation uses double precision.
    target_compile_options(cfwx_cuda PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--expt-relaxed-constexpr>)
    add_executable(cfwx_cuda_manual test/cuda_manual.c)
    target_link_libraries(cfwx_cuda_manual PRIVATE cfwx_cuda cfwx_logger)
    set_target_properties(cfwx_cuda_manual PROPERTIES LINKER_LANGUAGE CUDA)
    if(CFWX_REGISTER_GPU_TESTS AND BUILD_TESTING)
        add_test(NAME cuda_manual_gradient_and_training COMMAND cfwx_cuda_manual --test)
        set_tests_properties(cuda_manual_gradient_and_training PROPERTIES LABELS "gpu;manual")
    endif()
elseif(CFWX_REGISTER_GPU_TESTS)
    message(FATAL_ERROR "CFWX_REGISTER_GPU_TESTS requires CFWX_CUDA=ON")
endif()
